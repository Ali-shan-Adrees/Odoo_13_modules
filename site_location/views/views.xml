<?xml version="1.0"?>
<odoo>
    <data>
        <record id="view_sale_order_inherit" model="ir.ui.view">
            <field name="name">sale.order.inherit</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form" />
            <field name="arch" type="xml">
                <field name="date_order" position="after">
                    <field name="site_location_id"  options="{'no_open': True, 'no_create': True, 'no_edit':True}" />
                    <!-- domain="[('partner_id', '=', True)]" -->
                </field>
            </field>
        </record>
        <record id="view_invoice_tree_inherit" model="ir.ui.view">
            <field name="name">account.move.tree.inherit</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_invoice_tree" />
            <field name="arch" type="xml">
                <field name="invoice_date" position="before">
                    <field name="site_location_id"  options="{'no_open': True, 'no_create': True, 'no_edit':True}" />
                    <!-- domain="[('partner_id', '=', True)]" -->
                </field>
            </field>
        </record>
        <record id="view_invoice_inherit" model="ir.ui.view">
            <field name="name">account.move.inherit</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form" />
            <field name="arch" type="xml">
                <field name="invoice_date" position="after">
                    <field name="site_location_id"  options="{'no_open': True, 'no_create': True, 'no_edit':True}" />
                    <!-- domain="[('partner_id', '=', True)]" -->
                </field>
            </field>
        </record>
        <record id="site_location_tree_view" model="ir.ui.view">
            <field name="name">site_location.site_location.tree</field>
            <field name="model">site_location.site_location</field>
            <field name="arch" type="xml">
                <list string="Site Locations">
                    <field name="partner_id" options="{'no_open': True, 'no_create': True, 'no_edit':True}"/>
                    <field name="site_location" options="{'no_open': True, 'no_create': True, 'no_edit':True}"/>
                </list>
            </field>
        </record>
        <record id="site_location_form_view" model="ir.ui.view">
            <field name="name">site_location.site_location.form</field>
            <field name="model">site_location.site_location</field>
            <field name="arch" type="xml">
                <form string="Site Locations">
                    <sheet>
                        <group>
                            <!-- Main Group -->
                            <group>
                                <!-- Left Group -->
                                <field name="partner_id" options="{'no_open': True, 'no_create': True, 'no_edit':True}" />
                            </group>
                            <!-- Right Group -->
                            <group>
                                <field name="site_location" options="{'no_open': True, 'no_create': True, 'no_edit':True}" />
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="action_site_location" model="ir.actions.act_window">
            <field name="name">Site Locations</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">site_location.site_location</field>
            <field name="view_mode">list,form,kanban</field>
            <field name="context">{'search_default_male':1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                </p>
            </field>
        </record>
    </data>
</odoo>
